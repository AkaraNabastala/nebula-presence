
import React, { useEffect, useState } from 'react';
import { CalendarDays, ClipboardList, Users, Plus, BookOpen, RefreshCw } from 'lucide-react';
import api from '../api/axios';
import Swal from 'sweetalert2';

const inputClass = "w-full px-3 py-2 rounded-xl border border-slate-200 bg-white text-slate-800 outline-none focus:ring-2 focus:ring-indigo-400 dark:bg-slate-700 dark:border-slate-600 dark:text-white";
const cardClass = "bg-white rounded-2xl border border-slate-100 shadow-sm p-5 dark:bg-slate-800 dark:border-slate-700";
const today = () => {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
};

export default function Extracurricular() {
    const [tab, setTab] = useState('ekskul');
    const [items, setItems] = useState([]);
    const [members, setMembers] = useState([]);
    const [attendance, setAttendance] = useState([]);
    const [journals, setJournals] = useState([]);
    const [selected, setSelected] = useState('');
    const [date, setDate] = useState(today());
    const [loading, setLoading] = useState(false);

    const [name, setName] = useState('');
    const [supervisor, setSupervisor] = useState('');
    const [scheduleDays, setScheduleDays] = useState([]);
    const [scheduleStart, setScheduleStart] = useState('15:00');
    const [scheduleEnd, setScheduleEnd] = useState('16:30');

    const [memberId, setMemberId] = useState('');
    const [registeredStudents, setRegisteredStudents] = useState([]);
    const [selectedStudentIds, setSelectedStudentIds] = useState([]);
    const [savingMembers, setSavingMembers] = useState(false);
    const [status, setStatus] = useState('Hadir');
    const [attendanceNotes, setAttendanceNotes] = useState('');
    const [attendanceDrafts, setAttendanceDrafts] = useState({});
    const [savingAttendance, setSavingAttendance] = useState(false);

    const [topic, setTopic] = useState('');
    const [startTime, setStartTime] = useState('');
    const [endTime, setEndTime] = useState('');
    const [activityDescription, setActivityDescription] = useState('');
    const [attendanceCount, setAttendanceCount] = useState('0');
    const [journalNotes, setJournalNotes] = useState('');

    const loadExtracurriculars = async () => {
        try {
            const res = await api.get('/extracurriculars');
            const data = res.data?.data || [];
            setItems(data);
            if (!selected && data.length) setSelected(String(data[0].id));
        } catch (err) {
            Swal.fire('Gagal', err.response?.data?.message || 'Gagal memuat data ekskul.', 'error');
        }
    };

    
    const loadMembers = async () => {
        try {
            const res = await api.get('/members');
            const data = res.data?.data || res.data;
            setMembers(Array.isArray(data) ? data : []);
        } catch (err) {
            console.error('Gagal memuat peserta', err);
        }
    };
    
    const loadExtracurricularMembers = async () => {
        if (!selected) {
            setRegisteredStudents([]);
            setSelectedStudentIds([]);
            return;
        }

        try {
            const res = await api.get('/extracurriculars/members', {
                params: { extracurricular_id: selected }
            });
            const data = res.data?.data || [];

            setRegisteredStudents(data);
            setSelectedStudentIds(
                data.filter(student => Number(student.is_registered) === 1)
                    .map(student => String(student.id))
            );
        } catch (err) {
            Swal.fire(
                'Gagal',
                err.response?.data?.message || 'Gagal memuat anggota ekskul.',
                'error'
            );
        }
    };

    const saveExtracurricularMembers = async () => {
        if (!selected) {
            return Swal.fire('Perhatian', 'Pilih ekskul terlebih dahulu.', 'warning');
        }

        setSavingMembers(true);
        try {
            await api.post('/extracurriculars/members', {
                extracurricular_id: Number(selected),
                member_ids: selectedStudentIds.map(Number)
            });

            Swal.fire('Berhasil', 'Pendaftaran siswa berhasil disimpan.', 'success');
            await loadExtracurricularMembers();
            await loadExtracurriculars();
        } catch (err) {
            Swal.fire(
                'Gagal',
                err.response?.data?.message || 'Gagal menyimpan anggota ekskul.',
                'error'
            );
        } finally {
            setSavingMembers(false);
        }
    };

    const supervisors = members.filter(member =>
        ['guru', 'staff'].includes(String(member.role || '').toLowerCase())
    );

    const students = members.filter(member =>
        String(member.role || '').toLowerCase() === 'siswa'
    );

    const loadAttendance = async () => {
        if (!selected) {
            setAttendance([]);
            setAttendanceDrafts({});
            return;
        }

        try {
            const res = await api.get('/extracurriculars/attendance', {
                params: { extracurricular_id: selected, date }
            });

            const records = res.data?.data || [];
            setAttendance(records);

            const drafts = {};
            const registered = registeredStudents.filter(
                student => Number(student.is_registered) === 1
            );

            registered.forEach(student => {
                const saved = records.find(
                    record => String(record.member_id) === String(student.id)
                );

                drafts[String(student.id)] = {
                    status: saved?.status || 'Hadir',
                    notes: saved?.notes || ''
                };
            });

            setAttendanceDrafts(drafts);
        } catch (err) {
            Swal.fire(
                'Gagal',
                err.response?.data?.message || 'Gagal memuat absensi.',
                'error'
            );
        }
    };

    const loadJournals = async () => {
        try {
            const res = await api.get('/extracurriculars/journals', {
                params: { extracurricular_id: selected || undefined }
            });
            setJournals(res.data?.data || []);
        } catch (err) {
            Swal.fire('Gagal', err.response?.data?.message || 'Gagal memuat jurnal.', 'error');
        }
    };

    const refresh = async () => {
        setLoading(true);
        await Promise.all([loadExtracurriculars(), loadMembers()]);
        setLoading(false);
    };

    useEffect(() => {
        refresh();
    }, []);

    useEffect(() => {
        if (selected) {
            loadAttendance();
            loadJournals();
        }
    }, [selected, date]);

    
    useEffect(() => {
        loadExtracurricularMembers();
    }, [selected]);

    
    const addExtracurricular = async (e) => {
        e.preventDefault();

        if (scheduleDays.length === 0) {
            return Swal.fire('Perhatian', 'Pilih minimal satu hari jadwal.', 'warning');
        }

        if (!scheduleStart || !scheduleEnd || scheduleEnd <= scheduleStart) {
            return Swal.fire('Perhatian', 'Jam selesai harus setelah jam mulai.', 'warning');
        }

        const scheduleText =
            `${scheduleDays.join(', ')} | ${scheduleStart}-${scheduleEnd}`;

        try {
            await api.post('/extracurriculars', {
                name,
                supervisor_name: supervisor,
                schedule: scheduleText
            });

            Swal.fire('Berhasil', 'Ekskul berhasil ditambahkan.', 'success');
            setName('');
            setSupervisor('');
            setSchedule('');
            setScheduleDays([]);
            setScheduleStart('15:00');
            setScheduleEnd('16:30');
            await loadExtracurriculars();
        } catch (err) {
            Swal.fire(
                'Gagal',
                err.response?.data?.message || 'Gagal menambahkan ekskul.',
                'error'
            );
        }
    };

    
    const saveAttendance = async (e) => {
        e.preventDefault();

        if (!selected || !memberId) {
            return Swal.fire(
                'Perhatian',
                'Pilih ekskul dan peserta terlebih dahulu.',
                'warning'
            );
        }

        try {
            await api.post('/extracurriculars/attendance', {
                extracurricular_id: Number(selected),
                member_id: Number(memberId),
                attendance_date: date,
                status,
                notes: attendanceNotes
            });

            Swal.fire('Berhasil', 'Absensi berhasil disimpan.', 'success');
            setAttendanceNotes('');
            await loadAttendance();
        } catch (err) {
            Swal.fire(
                'Gagal',
                err.response?.data?.message || 'Gagal menyimpan absensi.',
                'error'
            );
        }
    };

    const saveAttendanceBulk = async () => {
        if (!selected) {
            return Swal.fire('Perhatian', 'Pilih ekskul terlebih dahulu.', 'warning');
        }

        const studentsToSave = registeredStudents.filter(
            student => Number(student.is_registered) === 1
        );

        if (studentsToSave.length === 0) {
            return Swal.fire(
                'Perhatian',
                'Belum ada siswa yang terdaftar pada ekskul ini.',
                'warning'
            );
        }

        const records = studentsToSave.map(student => {
            const draft = attendanceDrafts[String(student.id)] || {};

            return {
                member_id: Number(student.id),
                status: draft.status || 'Hadir',
                notes: draft.notes || ''
            };
        });

        setSavingAttendance(true);

        try {
            const res = await api.post('/extracurriculars/attendance/bulk', {
                extracurricular_id: Number(selected),
                attendance_date: date,
                records
            });

            await loadAttendance();

            await Swal.fire(
                'Berhasil',
                res.data?.message || 'Semua absensi berhasil disimpan.',
                'success'
            );
        } catch (err) {
            Swal.fire(
                'Gagal',
                err.response?.data?.message || 'Gagal menyimpan absensi massal.',
                'error'
            );
        } finally {
            setSavingAttendance(false);
        }
    };


    const saveJournal = async (e) => {
        e.preventDefault();
        if (!selected || !topic.trim()) {
            return Swal.fire('Perhatian', 'Pilih ekskul dan isi topik kegiatan.', 'warning');
        }
        try {
            await api.post('/extracurriculars/journals', {
                extracurricular_id: Number(selected),
                activity_date: date,
                start_time: startTime || null,
                end_time: endTime || null,
                topic,
                activity_description: activityDescription,
                attendance_count: Number(attendanceCount) || 0,
                notes: journalNotes
            });
            Swal.fire('Berhasil', 'Jurnal kegiatan berhasil disimpan.', 'success');
            setTopic('');
            setStartTime('');
            setEndTime('');
            setActivityDescription('');
            setAttendanceCount('0');
            setJournalNotes('');
            await loadJournals();
        } catch (err) {
            Swal.fire('Gagal', err.response?.data?.message || 'Gagal menyimpan jurnal.', 'error');
        }
    };

    const tabs = [
        { id: 'ekskul', label: 'Data Ekskul', icon: Users },
        { id: 'absensi', label: 'Absensi', icon: ClipboardList },
        { id: 'jurnal', label: 'Jurnal Kegiatan', icon: BookOpen }
    ];

    return (
        <div className="p-4 md:p-6 max-w-7xl mx-auto space-y-6">
            <div className={`${cardClass} flex flex-wrap items-center justify-between gap-4`}>
                <div>
                    <h1 className="text-2xl font-bold text-slate-800 dark:text-white">
                        Monitoring Ekstrakurikuler
                    </h1>
                    <p className="text-sm text-slate-500 dark:text-slate-400 mt-1">
                        Pantau data ekskul, rekap absensi peserta, dan riwayat jurnal tanpa mengubah data.
                    </p>
                </div>
                <button onClick={refresh} disabled={loading}
                    className="flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white disabled:opacity-50">
                    <RefreshCw size={16} className={loading ? 'animate-spin' : ''} />
                    Muat Ulang
                </button>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div className={cardClass}>
                    <p className="text-sm text-slate-500 dark:text-slate-400">Total Ekskul</p>
                    <p className="text-3xl font-bold mt-2 text-indigo-600">{items.length}</p>
                </div>
                <div className={cardClass}>
                    <p className="text-sm text-slate-500 dark:text-slate-400">Catatan Absensi ({date})</p>
                    <p className="text-3xl font-bold mt-2 text-emerald-600">{attendance.length}</p>
                </div>
                <div className={cardClass}>
                    <p className="text-sm text-slate-500 dark:text-slate-400">Jurnal Kegiatan</p>
                    <p className="text-3xl font-bold mt-2 text-amber-600">{journals.length}</p>
                </div>
            </div>

            <div className="flex gap-2 overflow-x-auto">
                {tabs.map(({ id, label, icon: Icon }) => (
                    <button key={id} onClick={() => setTab(id)}
                        className={`flex items-center gap-2 px-4 py-3 rounded-xl font-medium whitespace-nowrap ${
                            tab === id
                                ? 'bg-indigo-600 text-white'
                                : 'bg-white text-slate-600 border border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700'
                        }`}>
                        <Icon size={18} /> {label}
                    </button>
                ))}
            </div>

            {tab === 'ekskul' && (
                <div className={cardClass}>
                    <h2 className="font-bold text-slate-800 dark:text-white mb-4">
                        Daftar Ekskul
                    </h2>
                    <div className="overflow-x-auto">
                        <table className="w-full text-sm text-left">
                            <thead className="bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300">
                                <tr>
                                    <th className="p-3">Nama</th>
                                    <th className="p-3">Pembina</th>
                                    <th className="p-3">Jadwal</th>
                                    <th className="p-3">Peserta Tercatat</th>
                                </tr>
                            </thead>
                            <tbody className="divide-y divide-slate-100 dark:divide-slate-700">
                                {items.map(item => (
                                    <tr key={item.id}>
                                        <td className="p-3 font-medium text-slate-800 dark:text-white">{item.name}</td>
                                        <td className="p-3 text-slate-600 dark:text-slate-300">{item.supervisor_name || '-'}</td>
                                        <td className="p-3 text-slate-600 dark:text-slate-300">{item.schedule || '-'}</td>
                                        <td className="p-3 text-slate-600 dark:text-slate-300">{item.total_peserta ?? 0}</td>
                                    </tr>
                                ))}
                                {!items.length && (
                                    <tr><td colSpan="4" className="p-6 text-center text-slate-400">Belum ada data ekskul.</td></tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            )}

            {tab === 'ekskul' && (
                <div className={cardClass}>
                    <h2 className="font-bold text-slate-800 dark:text-white mb-2">Anggota Ekskul</h2>
                    <label className="block text-sm text-slate-600 dark:text-slate-300 mb-4">
                        Pilih ekskul
                        <select value={selected} onChange={e => setSelected(e.target.value)} className={`${inputClass} mt-1`}>
                            <option value="">Pilih ekskul</option>
                            {items.map(item => (
                                <option key={item.id} value={item.id}>{item.name}</option>
                            ))}
                        </select>
                    </label>
                    <div className="divide-y divide-slate-100 dark:divide-slate-700">
                        {registeredStudents.map(student => (
                            <div key={student.id} className="flex items-center justify-between gap-3 p-3">
                                <span className="text-sm text-slate-800 dark:text-slate-200">
                                    {student.full_name}
                                    {student.identity_number ? ` (${student.identity_number})` : ''}
                                </span>
                                <span className="text-xs text-slate-500 dark:text-slate-400">
                                    {Number(student.is_registered) === 1 ? 'Terdaftar' : 'Belum terdaftar'}
                                </span>
                            </div>
                        ))}
                        {!selected && <p className="p-4 text-sm text-slate-500">Pilih ekskul untuk melihat anggotanya.</p>}
                        {selected && !registeredStudents.length && <p className="p-4 text-sm text-slate-500">Belum ada data anggota.</p>}
                    </div>
                </div>
            )}

            {tab === 'absensi' && (
                <div className={`${cardClass} space-y-4`}>
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <label className="block text-sm text-slate-600 dark:text-slate-300">
                            Ekskul
                            <select value={selected} onChange={e => setSelected(e.target.value)} className={`${inputClass} mt-1`}>
                                <option value="">Pilih ekskul</option>
                                {items.map(item => (
                                    <option key={item.id} value={item.id}>{item.name}</option>
                                ))}
                            </select>
                        </label>
                        <label className="block text-sm text-slate-600 dark:text-slate-300">
                            Tanggal
                            <input type="date" value={date} onChange={e => setDate(e.target.value)} className={`${inputClass} mt-1`} />
                        </label>
                    </div>
                    <div>
                        <h2 className="font-bold text-slate-800 dark:text-white mb-4">Rekap Absensi</h2>
                        <div className="overflow-x-auto">
                            <table className="w-full text-sm text-left">
                                <thead className="bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300">
                                    <tr>
                                        <th className="p-3">Peserta</th>
                                        <th className="p-3">Nomor Identitas</th>
                                        <th className="p-3">Status</th>
                                        <th className="p-3">Catatan</th>
                                    </tr>
                                </thead>
                                <tbody className="divide-y divide-slate-100 dark:divide-slate-700">
                                    {attendance.map(a => (
                                        <tr key={a.id}>
                                            <td className="p-3 text-slate-800 dark:text-white">{a.full_name}</td>
                                            <td className="p-3 text-slate-600 dark:text-slate-300">{a.identity_number || '-'}</td>
                                            <td className="p-3">{a.status}</td>
                                            <td className="p-3 text-slate-600 dark:text-slate-300">{a.notes || '-'}</td>
                                        </tr>
                                    ))}
                                    {!attendance.length && (
                                        <tr><td colSpan="4" className="p-6 text-center text-slate-400">Belum ada absensi pada tanggal ini.</td></tr>
                                    )}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            )}

            {tab === 'jurnal' && (
                <div className="grid grid-cols-1 gap-6">

                    <div className={cardClass}>
                        <h2 className="font-bold text-slate-800 dark:text-white mb-4">Riwayat Jurnal</h2>
                        <div className="space-y-3">
                            {journals.map(j => (
                                <article key={j.id} className="border border-slate-100 rounded-xl p-4 dark:border-slate-700">
                                    <div className="flex flex-wrap justify-between gap-2">
                                        <h3 className="font-bold text-slate-800 dark:text-white">{j.topic}</h3>
                                        <span className="text-sm text-indigo-600 dark:text-indigo-400">{j.activity_date ? String(j.activity_date).slice(0, 10) : '-'}</span>
                                    </div>
                                    <p className="text-sm text-slate-500 dark:text-slate-400 mt-1">{j.extracurricular_name}</p>
                                    <p className="text-sm text-slate-700 dark:text-slate-300 mt-2 whitespace-pre-wrap">{j.activity_description || 'Tidak ada deskripsi.'}</p>
                                    <div className="flex flex-wrap gap-4 text-xs text-slate-500 dark:text-slate-400 mt-3">
                                        <span><CalendarDays size={14} className="inline mr-1" />{j.start_time || '--:--'} – {j.end_time || '--:--'}</span>
                                        <span><Users size={14} className="inline mr-1" />{j.attendance_count ?? 0} peserta</span>
                                    </div>
                                    {j.notes && <p className="text-sm mt-2 text-slate-600 dark:text-slate-300">Catatan: {j.notes}</p>}
                                </article>
                            ))}
                            {!journals.length && <p className="text-center text-slate-400 py-8">Belum ada jurnal kegiatan.</p>}
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
}
